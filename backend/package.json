{
  "name": "cbrucenclex-backend",
  "version": "1.0.0",
  "description": "Dynamic site served by Node",
  "main": "server.js",
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "node database/prisma.js generate",
    "prisma:format": "node database/prisma.js format",
    "db:push": "node database/prisma.js db push",
    "db:migrate": "node database/prisma.js migrate dev",
    "db:studio": "node database/prisma.js studio",
    "setup": "npm run prisma:generate && npm run db:push",
    "seed": "node database/seed.js",
    "init": "npm run setup && npm run seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "express": "5.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemon": "^3.1.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "prisma": "6.19.3"
  }
}
