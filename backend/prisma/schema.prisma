generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  draft
  published
}

enum CommentStatus {
  pending
  approved
  rejected
}

enum StudentStatus {
  ACTIVE
  DISABLED
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_RESPONSE
  EXTENDED_MULTIPLE_RESPONSE
  DRAG_DROP
  HOT_SPOT
  MATRIX_GRID
  CLOZE_DROP_DOWN
  CASE_STUDY
  RATIONALE_PAIRED
  BOW_TIE
}

enum ScoringMethod {
  ZERO_ONE
  PLUS_MINUS
  RATIONALE
}

enum ClientNeedCategory {
  MANAGEMENT_OF_CARE
  SAFETY_AND_INFECTION_CONTROL
  HEALTH_PROMOTION_AND_MAINTENANCE
  PSYCHOSOCIAL_INTEGRITY
  BASIC_CARE_AND_COMFORT
  PHARMACOLOGICAL_AND_PARENTERAL_THERAPIES
  REDUCTION_OF_RISK_POTENTIAL
  PHYSIOLOGICAL_ADAPTATION
}

enum CategoryType {
  BLOG
  STUDY
}

enum ExamMode {
  PRACTICE
  TEST
}

enum AccessTier {
  FREE
  PREMIUM
}

enum VideoStatus {
  PROCESSING
  DRAFT
  PUBLISHED
  FAILED
}

model Admin {
  id         Int        @id @default(autoincrement())
  username   String     @unique @db.VarChar(255)
  password   String     @db.VarChar(255)
  email      String?    @db.VarChar(255)
  created_at DateTime   @default(now()) @db.Timestamp(6)
  updated_at DateTime   @updatedAt @db.Timestamp(6)
  posts      Post[]
  students   Student[]  @relation("StudentCreator")
  questions  Question[] @relation("QuestionCreator")

  @@map("admins")
}

model Student {
  id                   String        @id @default(uuid()) @db.Uuid
  full_name            String        @db.VarChar(255)
  email                String        @unique @db.VarChar(255)
  password             String        @db.VarChar(255)
  status               StudentStatus @default(ACTIVE)
  must_change_password Boolean       @default(true)
  access_tier          AccessTier    @default(FREE)
  premium_until        DateTime?     @db.Timestamp(6)
  created_by           Int?
  created_at           DateTime      @default(now()) @db.Timestamp(6)
  updated_at           DateTime      @updatedAt @db.Timestamp(6)
  creator              Admin?        @relation("StudentCreator", fields: [created_by], references: [id], onDelete: SetNull)
  exam_sessions        ExamSession[]
  answers              UserAnswer[]

  @@index([status])
  @@map("students")
}

model Question {
  id                String                @id @default(uuid()) @db.Uuid
  external_id       String?               @unique @db.VarChar(100)
  stem              String                @db.Text
  prompt            String                @db.Text
  options           Json
  content           Json                  @default("{}")
  correct_answers   Json
  rationale         String                @db.Text
  client_need       ClientNeedCategory
  question_type     QuestionType
  scoring_method    ScoringMethod
  difficulty        Float                 @default(0.5)
  status            QuestionStatus        @default(DRAFT)
  access_tier       AccessTier            @default(FREE)
  created_by        Int?
  created_at        DateTime              @default(now()) @db.Timestamp(6)
  updated_at        DateTime              @updatedAt @db.Timestamp(6)
  creator           Admin?                @relation("QuestionCreator", fields: [created_by], references: [id], onDelete: SetNull)
  session_questions ExamSessionQuestion[]
  answers           UserAnswer[]

  @@index([client_need, question_type, status, access_tier])
  @@map("questions")
}

model ExamSession {
  id                String                @id @default(uuid()) @db.Uuid
  student_id        String                @db.Uuid
  mode              ExamMode
  client_need       ClientNeedCategory?
  is_completed      Boolean               @default(false)
  score             Float?
  max_score         Float?
  time_spent_sec    Int                   @default(0)
  question_count    Int
  created_at        DateTime              @default(now()) @db.Timestamp(6)
  completed_at      DateTime?             @db.Timestamp(6)
  student           Student               @relation(fields: [student_id], references: [id], onDelete: Cascade)
  session_questions ExamSessionQuestion[]
  answers           UserAnswer[]

  @@index([student_id, is_completed])
  @@map("exam_sessions")
}

model ExamSessionQuestion {
  id              String      @id @default(uuid()) @db.Uuid
  exam_session_id String      @db.Uuid
  question_id     String      @db.Uuid
  position        Int
  exam_session    ExamSession @relation(fields: [exam_session_id], references: [id], onDelete: Cascade)
  question        Question    @relation(fields: [question_id], references: [id], onDelete: Restrict)

  @@unique([exam_session_id, question_id])
  @@unique([exam_session_id, position])
  @@map("exam_session_questions")
}

model UserAnswer {
  id              String      @id @default(uuid()) @db.Uuid
  student_id      String      @db.Uuid
  exam_session_id String      @db.Uuid
  question_id     String      @db.Uuid
  selected        Json
  is_correct      Boolean
  points_earned   Float
  points_possible Float
  time_spent_sec  Int         @default(0)
  created_at      DateTime    @default(now()) @db.Timestamp(6)
  updated_at      DateTime    @updatedAt @db.Timestamp(6)
  student         Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)
  exam_session    ExamSession @relation(fields: [exam_session_id], references: [id], onDelete: Cascade)
  question        Question    @relation(fields: [question_id], references: [id], onDelete: Restrict)

  @@unique([exam_session_id, question_id])
  @@index([student_id, question_id])
  @@map("user_answers")
}

model Post {
  id             Int        @id @default(autoincrement())
  title          String     @db.VarChar(500)
  slug           String?    @unique @db.VarChar(500)
  content        String?    @db.Text
  excerpt        String?    @db.Text
  category       String?    @db.VarChar(100)
  author_id      Int?
  featured_image String?    @db.VarChar(500)
  status         PostStatus @default(draft)
  featured       Boolean    @default(false)
  published_at   DateTime?  @db.Timestamp(6)
  created_at     DateTime   @default(now()) @db.Timestamp(6)
  updated_at     DateTime   @updatedAt @db.Timestamp(6)
  author         Admin?     @relation(fields: [author_id], references: [id], onDelete: SetNull)
  comments       Comment[]

  @@index([status])
  @@index([category])
  @@index([published_at])
  @@map("posts")
}

model Category {
  id            Int                 @id @default(autoincrement())
  name          String              @unique @db.VarChar(100)
  slug          String?             @unique @db.VarChar(100)
  description   String?             @db.Text
  distribution  Int?
  client_need   ClientNeedCategory?
  type          CategoryType        @default(BLOG)
  domain_id     Int?
  display_order Int                 @default(0)
  is_published  Boolean             @default(true)
  created_at    DateTime            @default(now()) @db.Timestamp(6)
  domain        StudyDomain?        @relation(fields: [domain_id], references: [id], onDelete: SetNull)
  modules       StudyModule[]
  videos        Video[]

  @@map("categories")
}

model Video {
  id               String      @id @default(uuid()) @db.Uuid
  title            String      @db.VarChar(255)
  description      String?     @db.Text
  topic_id         Int?
  zoom_meeting_id  String?     @db.VarChar(100)
  s3_key           String?     @unique @db.VarChar(500)
  thumbnail_s3_key String?     @db.VarChar(500)
  duration_seconds Int?
  access_tier      AccessTier  @default(PREMIUM)
  status           VideoStatus @default(PROCESSING)
  published_at     DateTime?   @db.Timestamp(6)
  created_at       DateTime    @default(now()) @db.Timestamp(6)
  updated_at       DateTime    @updatedAt @db.Timestamp(6)
  topic            Category?   @relation(fields: [topic_id], references: [id], onDelete: SetNull)

  @@index([status, access_tier])
  @@index([topic_id])
  @@map("videos")
}

model StudyDomain {
  id            Int        @id @default(autoincrement())
  name          String     @unique @db.VarChar(150)
  description   String?    @db.Text
  display_order Int        @default(0)
  is_published  Boolean    @default(true)
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  updated_at    DateTime   @updatedAt @db.Timestamp(6)
  topics        Category[]

  @@map("study_domains")
}

model StudyModule {
  id                Int      @id @default(autoincrement())
  topic_id          Int
  title             String   @db.VarChar(200)
  summary           String?  @db.Text
  content           String?  @db.Text
  estimated_minutes Int?
  display_order     Int      @default(0)
  is_published      Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @updatedAt @db.Timestamp(6)
  topic             Category @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([topic_id, display_order])
  @@map("study_modules")
}

model Comment {
  id           Int           @id @default(autoincrement())
  post_id      Int
  parent_id    Int?
  author_name  String        @db.VarChar(255)
  author_email String?       @db.VarChar(255)
  content      String        @db.Text
  upvotes      Int           @default(0)
  status       CommentStatus @default(pending)
  created_at   DateTime      @default(now()) @db.Timestamp(6)
  updated_at   DateTime      @updatedAt @db.Timestamp(6)
  post         Post          @relation(fields: [post_id], references: [id], onDelete: Cascade)
  parent       Comment?      @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies      Comment[]     @relation("CommentReplies")

  @@index([post_id])
  @@index([status])
  @@index([parent_id])
  @@map("comments")
}

model Setting {
  id            Int      @id @default(autoincrement())
  setting_key   String   @unique @db.VarChar(255)
  setting_value String?  @db.Text
  setting_type  String   @default("string") @db.VarChar(50)
  description   String?  @db.Text
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  @@map("settings")
}

model PasswordResetOtp {
  id           String    @id @default(uuid()) @db.Uuid
  account_type String    @db.VarChar(20)
  email        String    @db.VarChar(255)
  code_hash    String    @db.VarChar(64)
  expires_at   DateTime  @db.Timestamp(6)
  attempts     Int       @default(0)
  used_at      DateTime? @db.Timestamp(6)
  created_at   DateTime  @default(now()) @db.Timestamp(6)

  @@index([account_type, email, created_at])
  @@index([expires_at])
  @@map("password_reset_otps")
}
