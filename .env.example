DATABASE_URL=postgresql://user:password@localhost:5432/cbrucenclex
PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
ADMIN_EMAIL=admin@your-verified-domain.com
CORS_ORIGINS=http://localhost:5173
RESEND_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=CBRUCENCLEX <noreply@your-verified-domain.com>
CONTACT_EMAIL=support@your-verified-domain.com

# AWS S3 question-image storage
# In production, prefer an IAM role attached to the VPS/EC2 instance. When an
# IAM role is used, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY unset.
AWS_REGION=us-east-1


# Required only when AWS issues temporary credentials.
AWS_SESSION_TOKEN=
AWS_S3_BUCKET_NAME=replace-with-question-image-bucket
AWS_S3_IMAGE_PREFIX=question-images

# Public image delivery URL, without a trailing slash. This can be an S3 public
# URL initially or a custom CloudFront domain later.
# Example: https://media.cbrucenclex.com
AWS_MEDIA_BASE_URL=https://media.yourdomain.com
